<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" /></startup>
  <!-- Supply values locally or use ARKYVA_CONNECTION_STRING and ARKYVA_STORAGE_PATH.
       Keep credentials out of source control. SQL schema V001-V004 must already exist. -->
  <connectionStrings>
    <add name="Arkyva" connectionString="" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Arkyva:StoragePath" value="" />
  </appSettings>
</configuration>
